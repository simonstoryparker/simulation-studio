{
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "minHeight": 600,
        "width": 1280,
        "minWidth": 900,
        "title": "Simulation Studio",
        "height": 820,
        "transparent": true,
        "acceptFirstMouse": true
      }
    ],
    "macOSPrivateApi": true
  },
  "identifier": "org.team581.simulation-studio",
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "version": "0.1.2",
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": [
      "resources/"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "productName": "Simulation Studio",
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/simonstoryparker/simulation-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
