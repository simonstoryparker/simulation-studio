{
  "private": true,
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "name": "simulation-studio",
  "type": "module",
  "scripts": {
    "desktop": "tauri dev",
    "package": "node scripts/package.mjs",
    "dev": "vite",
    "test": "vitest run src",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write src vite.config.ts && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "check": "npm run build && npm test && npm run test:release && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "test:release": "node --test scripts/*.test.mjs"
  },
  "version": "0.1.1",
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@types/three": "^0.186.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^1.5.0",
    "three": "^0.186.1"
  }
}
